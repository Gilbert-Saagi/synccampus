# Copy to backend/.env for local development. On Render or a hosting panel,
# set these as environment variables instead and never commit real values.

APP_ENV=development

# Either a full connection URL (Neon gives you one):
# DATABASE_URL=postgres://user:password@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require
# ...or separate MySQL settings (XAMPP defaults shown):
DB_DSN=mysql:host=127.0.0.1;port=3306;dbname=synccampus;charset=utf8mb4
DB_USER=root
DB_PASS=

# Long random strings. Keep ACCESS_CODE_PEPPER the same forever: changing it
# makes every existing student access code stop working.
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_CODE_PEPPER=replace-with-a-different-long-random-secret

# The system admin account. bin/migrate.php creates it if it does not exist.
# The admin signs in at /admin/ with a link emailed to this address.
BOOTSTRAP_ADMIN_EMAIL=

# Email for the admin sign-in link, sent through https://resend.com (free).
# Without a key, a development server shows the link on screen instead.
# Until you verify a domain with Resend, it only delivers to the address you
# signed up to Resend with, so use that as BOOTSTRAP_ADMIN_EMAIL.
RESEND_API_KEY=
MAIL_FROM=SyncCampus <onboarding@resend.dev>

# Public address of the site, used inside emailed links.
APP_URL=http://localhost:8000
